<div class="container p-0">
  <div class="card px-4">
    <input type="hidden" name="order_id" value="<%= order_id %>">
    <p class="h8 py-3">Payment Details</p>
    <form id="parent-form">
      <div class="col-12">
        <div class="row gx-3">
          <div class="d-flex flex-column">
            <p class="text mb-1">Person Name</p>
            <input class="form-control mb-3" type="text" placeholder="John MacClain" id="name">
          </div>
        </div>
        <div class="col-12">
          <div class="d-flex flex-column">
            <p class="text mb-1">Card Number</p>
            <input class="form-control mb-3" id="card_number" type="text" placeholder="1234 5678 435678" name="card_number">
          </div>
        </div>
        <div class="col-12">
          <div class="d-flex flex-column">
            <p class="text mb-1">UPI</p>
            <input class="form-control mb-3" id="upi" type="text" placeholder="example@upi" name="vpa">
          </div>
        </div>
        <div class="col-12">
          <div class="d-flex flex-column">
            <p class="text mb-1">Netbanking</p>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="bank" id="net_airtel" value="AIRP">
              <label class="form-check-label" for="net_airtel">
                Airtel Payment Bank
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="bank" id="net_union" value="UBIN">
              <label class="form-check-label" for="net_union">
                Union Bank of India
              </label>
            </div>
            
        </div>


        <div class="col-12">
          <div class="d-flex flex-column">
            <p class="text mb-1">wallet</p>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="wallet" id="wallet_freecharge" value="freecharge">
              <label class="form-check-label" for="wallet_freecharge">Freecharge</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="wallet" id="wallet_mobikwik" value="mobikwik">
              <label class="form-check-label" for="wallet_mobikwik">Mobikwik</label>
            </div>
        </div>







        <div class="col-6">
          <div class="d-flex flex-column">
            <p class="text mb-1">Expiry</p>
            <input class="form-control mb-3" id="card_expiry" type="text" placeholder="MM/YY" name="card_expiry">
          </div>
        </div>
        <div class="col-6">
          <div class="d-flex flex-column">
            <p class="text mb-1">CVV/CVC</p>
            <input class="form-control mb-3 pt-2" id="card_cvv" type="password" placeholder="***" name="card_cvv">
          </div>
        </div>

        <!-- Payment method selection -->
        <div class="col-12">
          <label for="payment-method">Select Payment Method:</label>
          <select class="form-control mb-3" id="payment-method">
            <option value="card">Card</option>
            <option value="upi">UPI</option>
            <option value="netbanking">Netbanking</option>
            <option value="wallet">Wallet</option>
            <option value="qr">QR Code</option>
            <option value="paylater">Pay Later</option>
          </select>
        </div>

        <div class="col-12">
          <input type="button" value="<%= amount %>" name="amount" class="btn btn-primary mb-3" onclick="pay();">
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  var razorpay = new Razorpay({
    key: 'rzp_test_v9Qzz296oIxlmW', // Replace with your Razorpay key
  });

  razorpay.once('ready', function(response) {
    console.log(response.methods);
  });

  function pay() {
    var paymentMethod = document.getElementById("payment-method").value;
    var data = {
      amount: '<%= amount %>',
      currency: "INR",
      email: 'gaurav.kumar@example.com',
      contact: '9123456780',
      order_id: '<%= order_id %>',
      notes: {
        address: 'Ground Floor, SJR Cyber, Laskar Hosur Road, Bengaluru',
      }
    };

    // Update data based on selected payment method
    if (paymentMethod === 'card') {
      data.method = 'card';
      data.card = {
        number: document.getElementById("card_number").value,
        name: document.getElementById("name").value,
        expiry_month: parseInt(document.getElementById("card_expiry").value.split('/')[0]),
        expiry_year: parseInt(document.getElementById("card_expiry").value.split('/')[1]),
        cvv: document.getElementById("card_cvv").value
      };
    } else if (paymentMethod === 'upi') {
      data.method = 'upi';
      data.upi = {
        vpa: document.getElementById("upi").value,
        flow: 'collect'
      };
    } else if (paymentMethod === 'netbanking') {
      data.method = 'netbanking';
      const selectedBank = document.querySelector('input[name="bank"]:checked');
      if (selectedBank) {
        data.bank = selectedBank.value;
      } else {
        data.bank = null;
      }
    } else if (paymentMethod === 'wallet') {
      data.method = 'wallet';
      const selectedWallet = document.querySelector('input[name="wallet"]:checked');
      if (selectedWallet) {
        data.wallet = selectedWallet.value;
      } else {
        data.wallet = null;
      }
    } else if (paymentMethod === 'qr') {
      data.method = 'upi';
      data.upi = {
        qr: true,
        timeout: 10
      };
    } else if (paymentMethod === 'paylater') {
      data.method = 'paylater';
      data.provider = 'amazonpay';
    }

    console.log(data);

    razorpay.createPayment(data);
    razorpay.on("payment.success", function (resp) {
      console.log("Payment success response:", resp);
    
      let razorpay_payment_id = resp.razorpay_payment_id;
      let razorpay_order_id = resp.razorpay_order_id;
      let razorpay_signature = resp.razorpay_signature;
      let paymentStatus = resp.payment_status || 'success'; // Assuming 'payment_status' is part of the response
    //let amount = '<%= amount %>';  // Amount value from the template or dynamic data
    
      console.log(razorpay_order_id, razorpay_payment_id, razorpay_signature);
    
      // Store data in cookies
      document.cookie = `razorpay_payment_id=${razorpay_payment_id}; path=/;`;
      document.cookie = `razorpay_order_id=${razorpay_order_id}; path=/;`;
      document.cookie = `razorpay_signature=${razorpay_signature}; path=/;`;
    //document.cookie = `payment_amount=${amount}; path=/;`;
      document.cookie = `payment_status=${paymentStatus}; path=/;`;
    
      // Send payment details to backend for verification
      $.ajax({
        url: "/checkout/pay-verify",  // Your backend route for payment verification
        type: "POST",
        data: {
          razorpay_payment_id: razorpay_payment_id,
          razorpay_order_id: razorpay_order_id,
          razorpay_signature: razorpay_signature,
          paymentStatus :paymentStatus,
       // amout :amount
        },
        success: function (response) {
          swal("Payment verification successful");
        },
        error: function (error) {
          console.log("Error in verifying payment", error);
        },
      });
    });
  }
</script>

